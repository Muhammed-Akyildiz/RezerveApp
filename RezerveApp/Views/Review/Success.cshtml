@{
    Layout = "_BookingLayout";
    ViewBag.PageTitle = "Değerlendirme";
    ViewBag.HideHeader = true;
}

<style>
    .success-container {
        max-width: 500px;
        margin: 60px auto;
        background: #1a1a24;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.05);
    }
    
    .icon-success {
        color: #25D366;
        margin-bottom: 24px;
    }
</style>

<div class="success-container">
    <svg class="icon-success" xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <h2 style="margin-bottom: 16px; color:#fff;">Bilgi</h2>
    <p style="color:#999; font-size:16px; line-height:1.6;">@ViewBag.Message</p>
</div>
