@model IEnumerable<RezerveApp.Models.SystemSetting>
@{
    ViewData["Title"] = "Sistem Ayarları";
    Layout = "_AdminLayout";
    ViewBag.PageEyebrow = "Ayarlar";
    ViewBag.PageTitle = "Sistem Ayarları";
    ViewBag.PageSubtitle = "Global uygulama ayarlarını yönetin";
    ViewBag.ActiveNav = "Settings";
}

<style>
    .custom-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center; padding: 20px; }
    .custom-modal.active { display: flex; }
    .modal-backdrop { position: absolute; inset: 0; }
    .modal-content { position: relative; background: var(--card); border: 1px solid var(--border); padding: 24px; border-radius: var(--radius-md); max-width: 500px; width: 100%; z-index: 1001; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .modal-header h3 { font-size: 18px; margin: 0; }
    .btn-close { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 20px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--text-muted); }
    .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
    textarea.input { min-height: 100px; resize: vertical; }
</style>

@section TopbarActions {
    <button class="btn btn-gold" onclick="openModal('addSettingModal')">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Yeni Ayar Ekle
    </button>
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: var(--success-soft); color: var(--success); padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--success); margin-bottom: 24px;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">
    <div class="card-header">
        <div>
            <h3>Kayıtlı Ayarlar</h3>
            <div class="card-header-sub">Sistemde tanımlı tüm değişkenler</div>
        </div>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Anahtar (Key)</th>
                    <th>Değer (Value)</th>
                    <th>Açıklama</th>
                    <th style="width: 150px; text-align: right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight: 600; color: var(--gold);">@item.Key</td>
                        <td>
                            <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @item.Value
                            </div>
                        </td>
                        <td style="color: var(--text-muted);">@item.Description</td>
                        <td style="text-align: right;">
                            <button class="btn" style="padding: 4px 10px; font-size: 12px;" onclick="openModal('editSettingModal-@item.Key')">Düzenle</button>
                            <form asp-action="DeleteSetting" asp-route-key="@item.Key" method="post" style="display: inline;" onsubmit="return confirm('Bu ayarı silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn" style="padding: 4px 10px; font-size: 12px; color: var(--danger); border-color: var(--danger-soft);">Sil</button>
                            </form>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="custom-modal" id="editSettingModal-@item.Key">
                        <div class="modal-backdrop" onclick="closeModal('editSettingModal-@item.Key')"></div>
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3>Ayar Düzenle</h3>
                                <button type="button" class="btn-close" onclick="closeModal('editSettingModal-@item.Key')">×</button>
                            </div>
                            <form asp-action="UpdateSetting" method="post">
                                <input type="hidden" name="key" value="@item.Key" />
                                <div class="form-group">
                                    <label>Anahtar</label>
                                    <input type="text" class="input" value="@item.Key" disabled />
                                </div>
                                <div class="form-group">
                                    <label>Değer</label>
                                    <textarea name="value" class="input">@item.Value</textarea>
                                </div>
                                <div class="form-group">
                                    <label>Açıklama</label>
                                    <input type="text" name="description" class="input" value="@item.Description" />
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn" onclick="closeModal('editSettingModal-@item.Key')">İptal</button>
                                    <button type="submit" class="btn btn-gold">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="custom-modal" id="addSettingModal">
    <div class="modal-backdrop" onclick="closeModal('addSettingModal')"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3>Yeni Ayar Ekle</h3>
            <button type="button" class="btn-close" onclick="closeModal('addSettingModal')">×</button>
        </div>
        <form asp-action="UpdateSetting" method="post">
            <div class="form-group">
                <label>Anahtar (Boşluksuz, İngilizce, örn: MaintenanceMode)</label>
                <input type="text" name="key" class="input" required />
            </div>
            <div class="form-group">
                <label>Değer</label>
                <textarea name="value" class="input" required></textarea>
            </div>
            <div class="form-group">
                <label>Açıklama</label>
                <input type="text" name="description" class="input" />
            </div>
            <div class="form-actions">
                <button type="button" class="btn" onclick="closeModal('addSettingModal')">İptal</button>
                <button type="submit" class="btn btn-gold">Ekle</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openModal(id) {
        document.getElementById(id).classList.add('active');
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('active');
    }
</script>
