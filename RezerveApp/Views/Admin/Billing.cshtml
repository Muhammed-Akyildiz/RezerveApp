@model List<RezerveApp.Models.BusinessSubscription>

@{
    Layout = "_AdminLayout";
    ViewBag.PageEyebrow = "Fatura ve Abonelikler";
    ViewBag.PageTitle = "Abonelik Takvimi";
    ViewBag.PageSubtitle = "İşletmelerin fatura durumlarını ve abonelik tarihlerini yönetin";
    ViewBag.ActiveNav = "Billing";
}

@section TopbarActions {
    <button class="btn btn-outline" onclick="window.location.reload();">
        <i data-lucide="refresh-cw" class="icon-sm"></i>
        Yenile
    </button>
}

<div class="card">
    <div class="card-header">
        <div>
            <h3>Aktif Abonelikler</h3>
            <div class="card-header-sub">Sisteme kayıtlı işletmelerin aktif abonelikleri</div>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>İşletme</th>
                    <th>Paket</th>
                    <th>Fatura Dönemi</th>
                    <th>Başlangıç Tarihi</th>
                    <th>Bitiş Tarihi</th>
                    <th>Durum</th>
                    <th style="text-align:right;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var sub in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(sub.Business?.Name ?? "Silinmiş İşletme")</strong>
                            </td>
                            <td>
                                <span class="tag tag--dark">@(sub.SubscriptionPlan?.Name ?? "Bilinmiyor")</span>
                            </td>
                            <td>
                                @(sub.BillingPeriod == RezerveApp.Models.BillingPeriod.Monthly ? "Aylık" : "Yıllık")
                            </td>
                            <td>
                                @sub.StartDate.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                @if (sub.EndDate.HasValue)
                                {
                                    @sub.EndDate.Value.ToString("dd.MM.yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Süresiz</span>
                                }
                            </td>
                            <td>
                                @if (sub.PaymentStatus == RezerveApp.Models.PaymentStatus.Paid)
                                {
                                    <span class="tag tag--success">Ödendi</span>
                                }
                                else if (sub.PaymentStatus == RezerveApp.Models.PaymentStatus.Failed)
                                {
                                    <span class="tag tag--danger">Başarısız</span>
                                }
                                else
                                {
                                    <span class="tag tag--warning">Bekliyor</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <button type="button" class="btn btn-outline btn-sm" onclick="openDateModal(@sub.Id, '@sub.StartDate.ToString("yyyy-MM-dd")', '@(sub.EndDate.HasValue ? sub.EndDate.Value.ToString("yyyy-MM-dd") : "")')">
                                    Tarihleri Güncelle
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            Kayıtlı aktif abonelik bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Date Update Modal -->
<div id="dateUpdateModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); z-index:999; align-items:center; justify-content:center;">
    <div style="background:#1a1a2e; padding:28px 32px; border-radius:14px; width:420px; max-width:90vw; border:1px solid rgba(255,255,255,0.08); box-shadow:0 20px 60px rgba(0,0,0,0.5);">

        <div style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
            <div style="width:36px; height:36px; border-radius:10px; background:rgba(201,162,39,0.12); display:flex; align-items:center; justify-content:center;">
                <i data-lucide="calendar-range" style="width:18px; height:18px; color:#C9A227;"></i>
            </div>
            <div>
                <h3 style="margin:0; font-size:16px; font-weight:700; color:#fff;">Tarihleri Güncelle</h3>
                <p style="margin:0; font-size:12px; color:rgba(255,255,255,0.4);">Abonelik başlangıç ve bitiş tarihini değiştirin</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="UpdateSubscriptionDates" method="post">
            <input type="hidden" name="id" id="modalSubId" />

            <div style="margin-bottom:16px;">
                <label style="display:block; font-size:13px; font-weight:600; color:rgba(255,255,255,0.7); margin-bottom:6px;">Başlangıç Tarihi</label>
                <input type="date" name="startDate" id="modalStartDate" required
                       style="width:100%; box-sizing:border-box; padding:11px 13px; border:1px solid rgba(255,255,255,0.1); border-radius:9px; background:#0d0d1a; color:#fff; font-size:14px; outline:none; color-scheme:dark; transition:border-color .2s;"
                       onfocus="this.style.borderColor='#C9A227'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
            </div>

            <div style="margin-bottom:24px;">
                <label style="display:block; font-size:13px; font-weight:600; color:rgba(255,255,255,0.7); margin-bottom:6px;">Bitiş Tarihi</label>
                <input type="date" name="endDate" id="modalEndDate" required
                       style="width:100%; box-sizing:border-box; padding:11px 13px; border:1px solid rgba(255,255,255,0.1); border-radius:9px; background:#0d0d1a; color:#fff; font-size:14px; outline:none; color-scheme:dark; transition:border-color .2s;"
                       onfocus="this.style.borderColor='#C9A227'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
            </div>

            <div style="display:flex; gap:12px; justify-content:flex-end;">
                <button type="button" class="btn btn-outline" onclick="closeDateModal()">İptal</button>
                <button type="submit" class="btn btn-gold">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openDateModal(id, startDate, endDate) {
            document.getElementById('modalSubId').value = id;
            document.getElementById('modalStartDate').value = startDate;
            document.getElementById('modalEndDate').value = endDate;
            document.getElementById('dateUpdateModal').style.display = 'flex';
        }

        function closeDateModal() {
            document.getElementById('dateUpdateModal').style.display = 'none';
        }
    </script>
}
