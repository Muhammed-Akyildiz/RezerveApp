@model RezerveApp.Models.Appointment

@{
    Layout = "_BookingLayout";
    ViewBag.PageTitle = "Randevu Onaylandı";
}

<style>
    .success-icon {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        margin: 0 auto 26px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .success-icon svg {
            width: 30px !important;
            height: 30px !important;
            max-width: 30px;
            max-height: 30px;
            stroke-width: 2.5;
        }
</style>

<div class="success-wrap">

    <div class="success-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12" />
        </svg>
    </div>

    <h1>Randevunuz Alındı</h1>

    <p>
        Randevu bilgileriniz aşağıda yer almaktadır.
        Belirtilen saatte sizi bekliyor olacağız.
    </p>

    <div class="success-code">
        <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        Onay Kodu: @ViewBag.ConfirmationCode
    </div>

    <div class="success-card">

        <div class="summary-list">

            <div class="summary-row">
                <div class="summary-label">
                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a2 2 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                    Hizmet
                </div>
                <div class="summary-value">@ViewBag.ServiceName</div>
            </div>

            <div class="summary-row">
                <div class="summary-label">
                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                    Berber
                </div>
                <div class="summary-value">@ViewBag.EmployeeName</div>
            </div>

            <div class="summary-row">
                <div class="summary-label">
                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    Tarih &amp; Saat
                </div>
                <div class="summary-value">
                    @ViewBag.Date · @ViewBag.Time
                </div>
            </div>

            <div class="summary-row">
                <div class="summary-label">
                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Ad Soyad
                </div>
                <div class="summary-value">@ViewBag.CustomerName</div>
            </div>

            <div class="summary-row">
                <div class="summary-label">
                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    Telefon
                </div>
                <div class="summary-value">@ViewBag.CustomerPhone</div>
            </div>

        </div>

        <div class="summary-total">
            <div class="summary-total-label">Toplam Tutar</div>
            <div class="summary-total-value">₺@ViewBag.TotalPrice</div>
        </div>

    </div>

    <div class="success-actions">

        <a href="@Url.Action("Index", "Booking", new { slug = ViewBag.BusinessSlug })"
           class="btn btn-outline">

            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>

            Yeni Randevu Oluştur

        </a>

        <a href="#"
           onclick="window.print(); return false;"
           class="btn btn-gold">

            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <polyline points="6 9 6 2 18 2 18 9" />
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <rect x="6" y="14" width="12" height="8" />
            </svg>

            Yazdır

        </a>

    </div>

</div>

<style>
    .success-wrap {
        width: min(760px, calc(100% - 32px));
        margin: 60px auto;
        text-align: center;
    }

    .success-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(197, 157, 74, 0.14);
        border: 1px solid rgba(197, 157, 74, 0.45);
        color: #c9a24d;
    }

        .success-icon svg {
            width: 36px;
            height: 36px;
            display: block;
        }

    .success-wrap h1 {
        margin: 0 0 12px;
        font-size: 36px;
        font-weight: 700;
    }

    .success-wrap > p {
        margin: 0 auto 20px;
        color: #999;
        line-height: 1.6;
        max-width: 600px;
    }

    .success-code {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        margin-bottom: 24px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 10px;
        background: #141414;
        color: #c9a24d;
        font-weight: 600;
    }

    .icon-sm {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
    }

    .success-card {
        text-align: left;
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 18px;
        overflow: hidden;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .summary-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #929292;
    }

    .summary-value {
        color: #f5f5f5;
        font-weight: 600;
        text-align: right;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px;
        background: #171714;
        border-top: 1px solid rgba(197,157,74,.2);
    }

    .summary-total-label {
        font-size: 17px;
        font-weight: 600;
    }

    .summary-total-value {
        color: #c9a24d;
        font-size: 26px;
        font-weight: 800;
    }

    .success-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 24px;
    }

        .success-actions .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            padding: 0 20px;
        }

        .success-actions .icon {
            width: 18px;
            height: 18px;
        }

    @@media (max-width: 600px) {
        .success-wrap

    {
        margin: 35px auto;
    }

    .success-wrap h1 {
        font-size: 28px;
    }

    .summary-row {
        align-items: flex-start;
    }

    .summary-value {
        max-width: 55%;
    }

    .success-actions {
        flex-direction: column;
    }

        .success-actions .btn {
            width: 100%;
        }

    }
    
</style>
