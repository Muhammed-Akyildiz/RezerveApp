@{
    Layout = ViewBag.Layout ?? "_BusinessLayout";
    ViewBag.PageTitle = "Hesap Ayarları";
    ViewBag.PageEyebrow = "Hesap";
    ViewBag.PageSubtitle = "Kullanıcı hesabınızı güncelleyin";
}

<div class="row">
    <div class="col-md-6 offset-md-3" style="margin: 0 auto; max-width: 600px; padding: 20px; border: 1px solid rgba(255,255,255,.08); border-radius: 18px; background: #121212;">
        <h2 style="margin-bottom: 20px;">Hesap Ayarları</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background: rgba(34,197,94,.12); color: #4ade80; border: 1px solid rgba(34,197,94,.3); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.3); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px;">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <form id="settingsForm" asp-controller="Account" asp-action="Settings" method="post" onsubmit="return handleSettingsOtp(event, this);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="emailOtpCode" id="emailOtpCode" />
            
            <h4 style="margin-top: 20px; margin-bottom: 10px; color: #fff;">İletişim Bilgileri</h4>
            
            <div style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 15px;">
                <label for="email" style="font-size: 13px; font-weight: 600;">E-posta Adresi</label>
                <input type="email" id="email" name="email" value="@ViewBag.Email" required style="padding: 12px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 9px; background: #0b0b0b; color: #fff;">
            </div>

            <div style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 15px;">
                <label for="phone" style="font-size: 13px; font-weight: 600;">Telefon Numarası</label>
                <input type="text" id="phone" name="phone" value="@ViewBag.Phone" style="padding: 12px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 9px; background: #0b0b0b; color: #fff;">
            </div>

            <hr style="border-top: 1px solid rgba(255,255,255,.08); margin: 30px 0;">

            <h4 style="margin-bottom: 5px; color: #fff;">Şifre Değiştir</h4>
            <p style="color: #8f8f8f; margin-bottom: 20px; font-size: 13px;">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakın.</p>
            
            <div style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 15px;">
                <label for="currentPassword" style="font-size: 13px; font-weight: 600;">Mevcut Şifre</label>
                <input type="password" id="currentPassword" name="currentPassword" style="padding: 12px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 9px; background: #0b0b0b; color: #fff;">
            </div>

            <div style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 15px;">
                <label for="newPassword" style="font-size: 13px; font-weight: 600;">Yeni Şifre</label>
                <input type="password" id="newPassword" name="newPassword" style="padding: 12px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 9px; background: #0b0b0b; color: #fff;">
            </div>

            <div style="display: flex; flex-direction: column; gap: 7px; margin-bottom: 25px;">
                <label for="confirmNewPassword" style="font-size: 13px; font-weight: 600;">Yeni Şifre (Tekrar)</label>
                <input type="password" id="confirmNewPassword" name="confirmNewPassword" style="padding: 12px 13px; border: 1px solid rgba(255,255,255,.1); border-radius: 9px; background: #0b0b0b; color: #fff;">
            </div>

            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" style="background: #c19a4b; color: #111; border: 0; border-radius: 9px; padding: 11px 16px; font-weight: 700; cursor: pointer;">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleSettingsOtp(e, form) {
            const originalPhone = '@ViewBag.Phone';
            const phoneInput = document.getElementById('phone');
            const newPasswordInput = document.getElementById('newPassword');
            const currentPasswordInput = document.getElementById('currentPassword');
            
            let needsPhoneOtp = false;
            let needsEmailOtp = false;

            if (phoneInput && phoneInput.value !== originalPhone) {
                needsPhoneOtp = true;
            }
            if (newPasswordInput && newPasswordInput.value.length > 0) {
                needsEmailOtp = true;
            }

            if (needsEmailOtp) {
                e.preventDefault();
                const otpCodeField = document.getElementById("emailOtpCode");
                if (!otpCodeField.value) {
                    Swal.fire({
                        title: 'Şifrenizi değiştirmek üzeresiniz',
                        text: 'Doğrulama kodu göndermek için lütfen bekleyin...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    const formData = new FormData();
                    formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

                    fetch('/Account/SendPasswordResetOtpToEmail', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Doğrulama Kodu Gönderildi',
                                text: 'Lütfen e-posta adresinize gönderilen 6 haneli kodu giriniz.',
                                input: 'text',
                                inputAttributes: { maxlength: 6 },
                                showCancelButton: true,
                                confirmButtonText: 'Doğrula ve Kaydet',
                                cancelButtonText: 'İptal',
                                preConfirm: (code) => {
                                    if (!code || code.length < 6) {
                                        Swal.showValidationMessage('Lütfen geçerli bir kod giriniz');
                                        return false;
                                    }
                                    return code;
                                }
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    otpCodeField.value = result.value;
                                    if (needsPhoneOtp) {
                                        requireBusinessOwnerOtp(function() {
                                            HTMLFormElement.prototype.submit.call(form);
                                        });
                                    } else {
                                        HTMLFormElement.prototype.submit.call(form);
                                    }
                                }
                            });
                        } else {
                            Swal.fire('Hata', data.message || 'Kod gönderilemedi.', 'error');
                        }
                    }).catch(() => Swal.fire('Hata', 'Bir bağlantı hatası oluştu.', 'error'));
                }
                return false;
            } else if (needsPhoneOtp) {
                e.preventDefault();
                requireBusinessOwnerOtp(function() {
                    HTMLFormElement.prototype.submit.call(form);
                });
                return false;
            }
            
            return true;
        }
    </script>
}
