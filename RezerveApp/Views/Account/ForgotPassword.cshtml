@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Şifremi Unuttum — RezerveApp</title>
    <meta name="description" content="Hesabınızın şifresini sıfırlayın.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <link rel="icon" href="/images/logo.png">
</head>

<body>

    <div class="auth-page">

        <div class="auth-form-side">
            <div class="auth-form-container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo" style="justify-content: center; text-decoration: none;">
                    <img src="~/images/logo.png" alt="RezerveApp Logo" style="height: 60px; object-fit: contain;" />
                </a>

                <h1 class="auth-title">Şifremi Unuttum</h1>

                <p class="auth-subtitle">
                    Hesabınıza kayıtlı e-posta adresini girin, size şifre sıfırlama bağlantısı gönderelim.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-error">
                        @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    <div class="auth-error" style="background-color: var(--color-success); border-color: var(--color-success); color: white;">
                        @ViewBag.Message
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post">

                    <div class="form-group">
                        <label class="form-label" for="email">
                            E-posta Adresi
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               class="form-input"
                               placeholder="ornek@email.com"
                               autocomplete="email"
                               required>
                    </div>

                    <button type="submit" class="btn btn--primary btn--full btn--lg">
                        Şifre Sıfırlama Bağlantısı Gönder
                    </button>

                    <div class="register-action" style="margin-top: var(--space-xl); text-align: center;">
                        <span style="color: var(--color-gray-500); font-size: var(--fs-sm);">Şifrenizi hatırladınız mı?</span>
                        <a asp-controller="Account" asp-action="Login" class="btn btn--secondary btn--full" style="margin-top: var(--space-md);">Giriş Yap</a>
                    </div>

                </form>

            </div>
        </div>

        <!-- Sağ taraf - Marka -->
        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <div class="auth-brand-icon" style="background: none; box-shadow: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h2>
                    Güvendesiniz
                </h2>
                <p>
                    Hesabınızı güvende tutmak için güçlü şifreler belirlemeyi unutmayın.
                    Sıfırlama bağlantısı ile saniyeler içinde yeni şifrenizi oluşturabilirsiniz.
                </p>
            </div>
        </div>

    </div>

</body>
</html>
