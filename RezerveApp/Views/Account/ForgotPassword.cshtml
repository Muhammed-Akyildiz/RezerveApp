@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifremi Unuttum — RezerveApp</title>
    <meta name="description" content="Hesabınızın şifresini telefon numaranızla sıfırlayın.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/auth.css">
    <link rel="icon" href="/images/logo.png">
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="auth-page">
        <div class="auth-form-side">
            <div class="auth-form-container">
                <a asp-controller="Home" asp-action="Index" class="auth-logo" style="justify-content: center; text-decoration: none;">
                    <img src="~/images/logo.png" alt="RezerveApp Logo" style="height: 60px; object-fit: contain;" />
                </a>

                <h1 class="auth-title">Şifremi Unuttum</h1>
                <p class="auth-subtitle" id="step1-subtitle">
                    Hesabınıza kayıtlı telefon numarasını girin, WhatsApp üzerinden doğrulama kodu gönderelim.
                </p>

                <!-- STEP 1: Phone Number -->
                <form id="step1-form" onsubmit="sendOtp(event)">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label" for="phone">Telefon Numarası</label>
                        <input type="tel" id="phone" name="phone" class="form-input" placeholder="05XX XXX XX XX" required>
                    </div>
                    <button type="submit" class="btn btn--primary btn--full btn--lg" id="btn-send-otp">
                        Doğrulama Kodu Gönder
                    </button>
                </form>

                <!-- STEP 2: Verify OTP and New Password -->
                <form id="step2-form" style="display: none;" onsubmit="resetPassword(event)">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label" for="otpCode">WhatsApp Doğrulama Kodu</label>
                        <input type="text" id="otpCode" name="otpCode" class="form-input" placeholder="123456" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="newPassword">Yeni Şifre</label>
                        <input type="password" id="newPassword" name="newPassword" class="form-input" required>
                    </div>
                    <button type="submit" class="btn btn--primary btn--full btn--lg" id="btn-reset-password">
                        Şifremi Sıfırla
                    </button>
                </form>

                <div class="register-action" style="margin-top: var(--space-xl); text-align: center;">
                    <span style="color: var(--color-gray-500); font-size: var(--fs-sm);">Şifrenizi hatırladınız mı?</span>
                    <a asp-controller="Account" asp-action="Login" class="btn btn--secondary btn--full" style="margin-top: var(--space-md);">Giriş Yap</a>
                </div>
            </div>
        </div>

        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <div class="auth-brand-icon" style="background: none; box-shadow: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h2>Güvendesiniz</h2>
                <p>
                    WhatsApp doğrulama kodu ile saniyeler içinde yeni şifrenizi oluşturabilirsiniz.
                </p>
            </div>
        </div>
    </div>

    <script>
        let resetToken = "";
        let currentPhone = "";

        async function sendOtp(e) {
            e.preventDefault();
            const phone = document.getElementById("phone").value;
            if (!phone) return;

            const btn = document.getElementById("btn-send-otp");
            btn.disabled = true;
            btn.innerHTML = "Gönderiliyor...";

            try {
                const formData = new FormData();
                formData.append("phone", phone);
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('/Account/SendPasswordResetOtp', { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    currentPhone = phone;
                    document.getElementById("step1-form").style.display = "none";
                    document.getElementById("step1-subtitle").style.display = "none";
                    document.getElementById("step2-form").style.display = "block";
                    Swal.fire('Başarılı', 'Doğrulama kodu WhatsApp ile gönderildi.', 'success');
                } else {
                    Swal.fire('Hata', result.message || 'Kod gönderilemedi.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = "Doğrulama Kodu Gönder";
                }
            } catch (err) {
                Swal.fire('Hata', 'Bir sorun oluştu.', 'error');
                btn.disabled = false;
                btn.innerHTML = "Doğrulama Kodu Gönder";
            }
        }

        async function resetPassword(e) {
            e.preventDefault();
            const code = document.getElementById("otpCode").value;
            const newPassword = document.getElementById("newPassword").value;
            if (!code || !newPassword) return;

            const btn = document.getElementById("btn-reset-password");
            btn.disabled = true;
            btn.innerHTML = "Sıfırlanıyor...";

            try {
                // First verify OTP
                const formData = new FormData();
                formData.append("phone", currentPhone);
                formData.append("code", code);
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

                const response = await fetch('/Account/VerifyPasswordResetOtp', { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success && result.token) {
                    resetToken = result.token;
                    
                    // Now reset password
                    const resetFormData = new FormData();
                    resetFormData.append("phone", currentPhone);
                    resetFormData.append("token", resetToken);
                    resetFormData.append("newPassword", newPassword);
                    resetFormData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

                    const resetRes = await fetch('/Account/ResetPasswordWithToken', { method: 'POST', body: resetFormData });
                    const resetResult = await resetRes.json();

                    if (resetResult.success) {
                        Swal.fire('Başarılı', 'Şifreniz başarıyla sıfırlandı.', 'success').then(() => {
                            window.location.href = '/Account/Login';
                        });
                    } else {
                        Swal.fire('Hata', resetResult.message || 'Şifre sıfırlanamadı.', 'error');
                        btn.disabled = false;
                        btn.innerHTML = "Şifremi Sıfırla";
                    }
                } else {
                    Swal.fire('Hata', result.message || 'Kod hatalı.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = "Şifremi Sıfırla";
                }
            } catch (err) {
                Swal.fire('Hata', 'Bir sorun oluştu.', 'error');
                btn.disabled = false;
                btn.innerHTML = "Şifremi Sıfırla";
            }
        }
    </script>
</body>
</html>
