@model dynamic
@{
    Layout = null;
    ViewData["Title"] = "Şifre Sıfırlama";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Şifre Sıfırlama — RezerveApp</title>
    <meta name="description" content="Hesabınızın şifresini sıfırlayın.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <link rel="icon" href="/images/logo.png">
</head>

<body>

    <div class="auth-page">

        <div class="auth-form-side">
            <div class="auth-form-container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo" style="justify-content: center; text-decoration: none;">
                    <img src="~/images/logo.png" alt="RezerveApp Logo" style="height: 60px; object-fit: contain;" />
                </a>

                <h1 class="auth-title">Yeni Şifre Belirleyin</h1>

                <p class="auth-subtitle">
                    Lütfen e-posta adresinizi ve yeni şifrenizi giriniz.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-error">
                        @ViewBag.Error
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="ResetPassword"
                      method="post">

                    <input type="hidden" name="code" value="@Model.Code" />

                    <div class="form-group">
                        <label class="form-label" for="email">
                            E-posta Adresi
                        </label>
                        <input type="email" id="email" name="email" class="form-input" required autocomplete="email">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">
                            Yeni Şifre
                        </label>
                        <input type="password" id="password" name="password" class="form-input" required autocomplete="new-password">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">
                            Yeni Şifre (Tekrar)
                        </label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" required autocomplete="new-password">
                    </div>

                    <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top: var(--space-md);">
                        Şifreyi Sıfırla
                    </button>

                </form>

            </div>
        </div>

        <!-- Sağ taraf - Marka -->
        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <div class="auth-brand-icon">
                    <i data-lucide="check-circle" style="width:40px;height:40px;color:var(--success);"></i>
                </div>
                <h2>
                    Yeni Bir Başlangıç
                </h2>
                <p>
                    Güçlü ve benzersiz bir şifre belirleyerek hesabınızı koruyun. 
                    Şifrenizi kimseyle paylaşmayın.
                </p>
            </div>
        </div>

    </div>

</body>
</html>
