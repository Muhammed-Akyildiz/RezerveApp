@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Giriş Yap — RezerveApp</title>
    <meta name="description" content="RezerveApp hesabınıza giriş yapın ve işletmenizi yönetmeye başlayın.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <link rel="icon" href="/images/logo.png">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <div class="auth-page">

        <!-- Sol taraf - Form -->
        <div class="auth-form-side">
            <div class="auth-form-container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo" style="justify-content: center; text-decoration: none;">
                    <img src="~/images/logo.png" alt="RezerveApp Logo" style="height: 60px; object-fit: contain;" />
                </a>

                <h1 class="auth-title">Tekrar hoş geldiniz</h1>

                <p class="auth-subtitle">
                    Hesabınıza giriş yaparak işletmenizi yönetmeye devam edin.
                </p>

                <!-- Hata mesajları -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    <div class="form-group">
                        <label class="form-label" for="email">
                            E-posta veya Telefon
                        </label>

                        <input type="text"
                               id="email"
                               name="email"
                               class="form-input"
                               placeholder="ornek@email.com veya 05xxxxxxxxx"
                               autocomplete="username"
                               required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">
                            Şifre
                        </label>

                        <div class="form-input-wrapper">
                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-input"
                                   placeholder="••••••••"
                                   autocomplete="current-password"
                                   required>

                            <button type="button"
                                    class="toggle-password"
                                    onclick="togglePassword('password', this)" style="background:none; border:none; color: var(--color-gray-400); cursor: pointer; padding: 0 var(--space-sm);">
                                <i data-lucide="eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-footer">

                        <div class="form-checkbox">
                            <input type="checkbox"
                                   id="remember"
                                   name="remember">

                            <label for="remember">
                                Beni hatırla
                            </label>
                        </div>

                        <a href="#" onclick="openResetPhoneModal(event)" class="form-link">
                            Şifremi unuttum
                        </a>

                    </div>

                    <button type="submit"
                            class="btn btn--primary btn--full btn--lg">
                        Giriş Yap
                    </button>

                </form>

                <div class="register-action" style="margin-top: var(--space-xl); text-align: center;">
                    <span>Henüz hesabınız yok mu?</span>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn--secondary btn--full">
                        Üye Ol
                    </a>
                </div>

            </div>
        </div>


        <!-- Sağ taraf - Marka -->
        <div class="auth-brand-side">

            <div class="auth-brand-content">

                <div class="auth-brand-icon">
                    <i data-lucide="scissors" style="width: 32px; height: 32px; color: var(--color-gold);"></i>
                </div>

                <h2>
                    İşletmenizi yönetmeye hazır mısınız?
                </h2>

                <p>
                    Randevularınızı, müşterilerinizi ve çalışanlarınızı
                    tek bir platformdan kolayca yönetin.
                </p>

                <div class="auth-brand-features">

                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="calendar-check" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>

                        <span class="auth-brand-feature__text">
                            Online randevu yönetimi
                        </span>
                    </div>

                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="bar-chart-2" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>

                        <span class="auth-brand-feature__text">
                            Detaylı raporlar ve analizler
                        </span>
                    </div>

                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="smartphone" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>

                        <span class="auth-brand-feature__text">
                            Her cihazdan erişim
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/lucide@0.447.0/dist/umd/lucide.min.js"></script>
    <script>
        lucide.createIcons();

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);

            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<i data-lucide="eye-off"></i>';
            }
            else {
                input.type = 'password';
                btn.innerHTML = '<i data-lucide="eye"></i>';
            }
            lucide.createIcons();
        }

        // --- PASSWORD RESET OTP FLOW ---
        let resetPhone = "";
        let resetToken = "";

        function openResetPhoneModal(e) {
            e.preventDefault();
            document.getElementById('resetPhoneModal').style.display = 'flex';
        }

        function closeModals() {
            document.querySelectorAll('.modal-overlay').forEach(el => el.style.display = 'none');
        }

        async function sendResetOtp() {
            const phone = document.getElementById('resetPhoneInput').value;
            if (!phone) {
                Swal.fire('Hata', 'Lütfen telefon numaranızı girin.', 'error');
                return;
            }
            resetPhone = phone;

            Swal.fire({ title: 'Kod gönderiliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Account/SendPasswordResetOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `phone=${encodeURIComponent(phone)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await response.json();
                if (data.success) {
                    Swal.close();
                    closeModals();
                    document.getElementById('resetOtpModal').style.display = 'flex';
                } else {
                    Swal.fire('Hata', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Hata', 'Sunucu hatası', 'error');
            }
        }

        async function verifyResetOtp() {
            const code = document.getElementById('resetOtpInput').value;
            if (code.length !== 6) {
                Swal.fire('Hata', 'Lütfen 6 haneli kodu eksiksiz girin.', 'error');
                return;
            }

            Swal.fire({ title: 'Doğrulanıyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Account/VerifyPasswordResetOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `phone=${encodeURIComponent(resetPhone)}&code=${encodeURIComponent(code)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await response.json();
                if (data.success) {
                    resetToken = data.token; // Identity token from backend
                    Swal.close();
                    closeModals();
                    document.getElementById('newPasswordModal').style.display = 'flex';
                } else {
                    Swal.fire('Hata', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Hata', 'Sunucu hatası', 'error');
            }
        }

        async function setNewPassword() {
            const newPassword = document.getElementById('newPasswordInput').value;
            const passwordRegex = /^(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*.,?_~\\-+=]).{6,}$/;
            if (!passwordRegex.test(newPassword)) {
                Swal.fire('Geçersiz Şifre', 'Şifreniz en az 6 karakter uzunluğunda olmalı, en az 1 büyük harf, 1 rakam ve 1 özel karakter içermelidir.', 'error');
                return;
            }

            Swal.fire({ title: 'Şifre güncelleniyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Account/ResetPasswordWithToken', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `phone=${encodeURIComponent(resetPhone)}&token=${encodeURIComponent(resetToken)}&newPassword=${encodeURIComponent(newPassword)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await response.json();
                if (data.success) {
                    closeModals();
                    Swal.fire('Başarılı', 'Şifreniz güncellendi. Yeni şifrenizle giriş yapabilirsiniz.', 'success');
                } else {
                    Swal.fire('Hata', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Hata', 'Sunucu hatası', 'error');
            }
        }
    </script>

    <!-- Modals -->
    <div id="resetPhoneModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div class="modal-content" style="position:relative; background:#fff; padding:30px; border-radius:12px; max-width:400px; width:90%; text-align:center;">
            <button type="button" onclick="closeModals()" style="position:absolute; top:15px; right:15px; background:none; border:none; cursor:pointer; color:#999; font-size:24px; line-height:1; padding:0;">
                &times;
            </button>
            <h3 style="margin-bottom:15px; color:#1a1a1a; font-family:'Inter', sans-serif;">Şifremi Unuttum</h3>
            <p style="margin-bottom:20px; color:#666; font-size:14px;">Kayıtlı telefon numaranızı girin. Size bir doğrulama kodu göndereceğiz.</p>
            <input type="tel" id="resetPhoneInput" class="form-input" style="text-align:center; font-size:18px; margin-bottom:20px;" placeholder="05XX XXX XX XX" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <button type="button" class="btn btn--primary btn--full" onclick="sendResetOtp()">Kodu Gönder</button>
            <button type="button" class="btn btn--secondary btn--full" style="margin-top:10px;" onclick="closeModals()">İptal</button>
        </div>
    </div>

    <div id="resetOtpModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div class="modal-content" style="position:relative; background:#fff; padding:30px; border-radius:12px; max-width:400px; width:90%; text-align:center;">
            <button type="button" onclick="closeModals()" style="position:absolute; top:15px; right:15px; background:none; border:none; cursor:pointer; color:#999; font-size:24px; line-height:1; padding:0;">
                &times;
            </button>
            <h3 style="margin-bottom:15px; color:#1a1a1a; font-family:'Inter', sans-serif;">Doğrulama Kodu</h3>
            <p style="margin-bottom:20px; color:#666; font-size:14px;">Telefonunuza gönderilen 6 haneli doğrulama kodunu giriniz.</p>
            <input type="text" id="resetOtpInput" class="form-input" style="text-align:center; letter-spacing:8px; font-size:24px; font-weight:bold; margin-bottom:20px;" maxlength="6" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <button type="button" class="btn btn--primary btn--full" onclick="verifyResetOtp()">Doğrula</button>
            <button type="button" class="btn btn--secondary btn--full" style="margin-top:10px;" onclick="closeModals()">İptal</button>
        </div>
    </div>

    <div id="newPasswordModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div class="modal-content" style="position:relative; background:#fff; padding:30px; border-radius:12px; max-width:400px; width:90%; text-align:center;">
            <button type="button" onclick="closeModals()" style="position:absolute; top:15px; right:15px; background:none; border:none; cursor:pointer; color:#999; font-size:24px; line-height:1; padding:0;">
                &times;
            </button>
            <h3 style="margin-bottom:15px; color:#1a1a1a; font-family:'Inter', sans-serif;">Yeni Şifre Belirleyin</h3>
            <p style="margin-bottom:20px; color:#666; font-size:14px;">Yeni şifrenizi aşağıya giriniz.</p>
            <input type="password" id="newPasswordInput" class="form-input" style="text-align:center; font-size:18px; margin-bottom:20px;" placeholder="Yeni Şifre" />
            <button type="button" class="btn btn--primary btn--full" onclick="setNewPassword()">Şifreyi Güncelle</button>
        </div>
    </div>
</body>
</html>

