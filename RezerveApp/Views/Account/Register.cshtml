@{
    Layout = null;
    ViewData["Title"] = "Ücretsiz Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kayıt Ol — RezerveApp</title>
    <meta name="description" content="Hesabınızı oluşturun ve işletmenizi yönetmeye başlayın.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/css/base.css">
    <link rel="stylesheet" href="~/css/components.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <link rel="icon" href="/images/logo.png">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <div class="auth-page">

        <!-- SOL TARAF - FORM -->
        <div class="auth-form-side">
            <div class="auth-form-container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo" style="justify-content: center; text-decoration: none;">
                    <img src="~/images/logo.png" alt="RezerveApp Logo" style="height: 60px; object-fit: contain;" />
                </a>

                <h1 class="auth-title">Hesabınızı oluşturun</h1>
                <p class="auth-subtitle">
                    Ücretsiz kayıt olun ve işletmenizin online randevu sistemini dakikalar içinde kurun.
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" onsubmit="event.preventDefault(); startRegistration();">
                    <input type="hidden" id="otpCode" name="otpCode" />
                    
                    <div class="form-group">
                        <label class="form-label" for="phone">Telefon Numarası</label>
                        <input type="tel" id="phone" name="phone" class="form-input" placeholder="05XX XXX XX XX" autocomplete="tel" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">E-posta</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="ornek@email.com" autocomplete="email" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Şifre</label>
                        <div class="form-input-wrapper">
                            <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" autocomplete="new-password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword('password', this)" style="background:none; border:none; color: var(--color-gray-400); cursor: pointer; padding: 0 var(--space-sm);">
                                <i data-lucide="eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirmPassword">Şifre Tekrar</label>
                        <div class="form-input-wrapper">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="••••••••" autocomplete="new-password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)" style="background:none; border:none; color: var(--color-gray-400); cursor: pointer; padding: 0 var(--space-sm);">
                                <i data-lucide="eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: var(--space-xl);">
                        <div class="form-checkbox">
                            <input type="checkbox" id="terms" required>
                            <label for="terms">
                                <a href="/Home/Terms" target="_blank" class="form-link">Kullanım koşullarını</a> ve <a href="/Home/Privacy" target="_blank" class="form-link">gizlilik politikasını</a> kabul ediyorum.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn--primary btn--full btn--lg">
                        Hesap Oluştur
                    </button>
                </form>

                <div class="login-action" style="margin-top: var(--space-xl); text-align: center;">
                    <span style="color: var(--color-gray-500); font-size: var(--fs-sm);">Zaten bir hesabınız var mı?</span>
                    <a asp-controller="Account" asp-action="Login" class="btn btn--secondary btn--full" style="margin-top: var(--space-md);">Giriş Yap</a>
                </div>

            </div>
        </div>

        <!-- SAĞ TARAF - MARKA -->
        <div class="auth-brand-side">
            <div class="auth-brand-content">
                <div class="auth-brand-icon">
                    <i data-lucide="rocket" style="width: 32px; height: 32px; color: var(--color-gold);"></i>
                </div>
                <h2>Dakikalar içinde başlayın</h2>
                <p>
                    Kayıt olduktan sonra işletmenizi oluşturun, hizmetlerinizi ekleyin ve hemen randevu almaya başlayın.
                </p>

                <div class="auth-brand-features">
                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="check" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>
                        <span class="auth-brand-feature__text">Kredi kartı gerektirmez</span>
                    </div>

                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="check" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>
                        <span class="auth-brand-feature__text">Ücretsiz plan ile başlayın</span>
                    </div>

                    <div class="auth-brand-feature">
                        <div class="auth-brand-feature__icon">
                            <i data-lucide="check" style="width: 20px; height: 20px; color: var(--color-gold);"></i>
                        </div>
                        <span class="auth-brand-feature__text">2 dakikada kurulum</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/lucide@0.447.0/dist/umd/lucide.min.js"></script>
    <script>
        lucide.createIcons();

        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<i data-lucide="eye-off"></i>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<i data-lucide="eye"></i>';
            }
            lucide.createIcons();
        }

        async function startRegistration() {
            const form = document.getElementById('registerForm');
            
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            
            const password = document.getElementById('password').value;
            const confirm = document.getElementById('confirmPassword').value;

            const passwordRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[!@@#$%^&*.,?_~\-+=]).{6,}$/;
            if (!passwordRegex.test(password)) {
                Swal.fire('Geçersiz Şifre', 'Şifreniz en az 6 karakter uzunluğunda olmalı, en az 1 büyük harf, 1 rakam ve 1 özel karakter içermelidir.', 'error');
                return;
            }

            if (password !== confirm) {
                Swal.fire('Hata', 'Şifreler eşleşmiyor.', 'error');
                return;
            }

            const phone = document.getElementById('phone').value;
            if (!phone) {
                Swal.fire('Hata', 'Lütfen telefon numaranızı girin.', 'error');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            try {
                Swal.fire({ title: 'Kod gönderiliyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                const response = await fetch('/Account/SendRegistrationOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `phone=${encodeURIComponent(phone)}&__RequestVerificationToken=${encodeURIComponent(token)}`
                });
                const data = await response.json();
                if (data.success) {
                    Swal.close();
                    document.getElementById('otpModal').style.display = 'flex';
                } else {
                    Swal.fire('Hata', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('Hata', 'Sunucu ile bağlantı kurulamadı.', 'error');
            }
        }

        function closeOtpModal() {
            document.getElementById('otpModal').style.display = 'none';
        }

        function verifyOtpAndSubmit() {
            const code = document.getElementById('otpInputModal').value;
            if (code.length !== 6) {
                Swal.fire('Hata', 'Lütfen 6 haneli kodu eksiksiz girin.', 'error');
                return;
            }
            document.getElementById('otpCode').value = code;
            closeOtpModal();
            Swal.fire({ title: 'Kayıt işlemi tamamlanıyor...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            
            const form = document.getElementById('registerForm');
            HTMLFormElement.prototype.submit.call(form);
        }
    </script>

    <!-- OTP Modal -->
    <div id="otpModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div class="modal-content" style="position:relative; background:#fff; padding:30px; border-radius:12px; max-width:400px; width:90%; text-align:center;">
            <button type="button" onclick="closeOtpModal()" style="position:absolute; top:15px; right:15px; background:none; border:none; cursor:pointer; color:#999; font-size:24px; line-height:1; padding:0;">
                &times;
            </button>
            <h3 style="margin-bottom:15px; color:#1a1a1a; font-family:'Inter', sans-serif;">Doğrulama Kodu</h3>
            <p style="margin-bottom:20px; color:#666; font-family:'Inter', sans-serif; font-size:14px;">Telefonunuza gönderilen 6 haneli doğrulama kodunu giriniz.</p>
            <input type="text" id="otpInputModal" class="form-input" style="text-align:center; letter-spacing:8px; font-size:24px; font-weight:bold; margin-bottom:20px;" maxlength="6" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
            <button type="button" class="btn btn--primary btn--full" onclick="verifyOtpAndSubmit()">Doğrula ve Kayıt Ol</button>
            <button type="button" class="btn btn--secondary btn--full" style="margin-top:10px;" onclick="closeOtpModal()">İptal</button>
        </div>
    </div>
</body>
</html>
