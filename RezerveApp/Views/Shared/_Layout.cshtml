<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RezerveApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RezerveApp.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Business"
                   asp-action="Index" style="display:flex; align-items:center; gap: 8px; text-decoration: none;">
                    <img src="~/images/logo.png?v=2" alt="RezerveApp Logo" style="height: 32px; object-fit: contain;" />
                    <span style="font-size: 20px; font-weight: 700; color: #000;">Rezerve<span style="color: var(--color-gold);">App</span></span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Business"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Business"
                               asp-action="Appointments">
                                Randevular
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Business"
                               asp-action="Services">
                                Hizmetler
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Business"
                               asp-action="Employees">
                                �al��anlar
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-danger"
                               asp-controller="Account"
                               asp-action="Logout">
                                ��k�� Yap
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RezerveApp
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
