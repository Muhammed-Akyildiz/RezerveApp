@* ==========================================================================
   _BookingLayout.cshtml — Customer booking site shell
   Placeholders to wire up to your backend:
     - ViewBag.Business -> your Business entity (Name, Phone, Address, LogoUrl, Slug)
       Used below as @ViewBag.Business.Name etc. Replace with a strongly typed
       BaseViewModel/Model property if you prefer (e.g. @Model.Business.Name).
   ========================================================================== *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.PageTitle - @(ViewBag.Business?.Name ?? "Randevu Al") - RezerveApp</title>
    @{
        var bookingLogoUrl = (string)ViewBag.Business?.LogoUrl;
    }
    @if (!string.IsNullOrEmpty((string)ViewBag.Business?.LogoUrl))
    {
        <link rel="icon" type="image/png" href="@bookingLogoUrl" />
    }
    else
    {
        <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .site-header {
            width: min(1200px, calc(100% - 32px));
            margin: 14px auto 0;
            padding: 14px 18px;
            background: #151513;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 14px;
            box-sizing: border-box;
        }

        .site-header-inner {
            width: 100%;
        }

        .biz-identity {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .biz-logo {
            width: 48px;
            height: 48px;
            flex: 0 0 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #c9a24d;
            color: #151515;
            font-size: 22px;
            font-weight: 800;
            object-fit: cover;
        }

        img.biz-logo {
            object-fit: cover;
        }

        .biz-name {
            font-size: 20px;
            font-weight: 700;
            color: #f5f5f5;
            margin-bottom: 4px;
        }

        .biz-meta-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        .biz-meta-item {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #999;
            font-size: 12px;
        }

            .biz-meta-item .icon-sm {
                width: 14px;
                height: 14px;
            }
    </style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="booking-body">
    @if (ViewBag.HideHeader != true)
    {
    <header class="site-header">
        <div class="site-header-inner">
            <div class="biz-identity">
                @if (!string.IsNullOrEmpty((string)ViewBag.Business?.LogoUrl))
                {
                    <img src="@(ViewBag.Business?.LogoUrl)" alt="@(ViewBag.Business?.Name)" class="biz-logo" />
                }
                else
                {
                    <div class="biz-logo">@(string.IsNullOrWhiteSpace(ViewBag.Business?.Name) ? "B" : ((string)ViewBag.Business.Name).Substring(0, 1).ToUpper())</div>
                }
                <div>
                    <div class="biz-name">@(ViewBag.Business?.Name ?? "Randevu Al")</div>
                    <div class="biz-meta-row">
                        <span class="biz-meta-item">
                            <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            @(ViewBag.Business?.Phone ?? "")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </header>
    }



    <main>
        @RenderBody()
    </main>

    <div id="toast-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/lucide@0.447.0/dist/umd/lucide.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/booking.js" asp-append-version="true"></script>
    <script>
        // Toast Notification System
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            const iconSvg = type === 'success' 
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toast-icon" style="width:20px;height:20px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toast-icon" style="width:20px;height:20px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;

            toast.innerHTML = `
                ${iconSvg}
                <div style="flex:1;">${message}</div>
                <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => toast.classList.add('show'), 10);
            
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 5000);
        }

        // Global TempData handling
        const tempDataSuccess = @Html.Raw(Json.Serialize(TempData["Success"] ?? TempData["SuccessMessage"] ?? ""));
        const tempDataError = @Html.Raw(Json.Serialize(TempData["Error"] ?? TempData["ErrorMessage"] ?? ""));
        
        if (tempDataSuccess && tempDataSuccess !== '') {
            setTimeout(() => showToast(tempDataSuccess, 'success'), 300);
        }
        if (tempDataError && tempDataError !== '') {
            setTimeout(() => Swal.fire({
                icon: 'error',
                title: 'Hata',
                text: tempDataError,
                confirmButtonColor: '#d4af37',
                confirmButtonText: 'Tamam',
                background: '#1a1a24',
                color: '#fff'
            }), 300);
        }
    </script>
    <script src="~/js/validation.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
