@model IEnumerable<RezerveApp.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "RezerveApp — Berberinizin Online Randevu Sistemi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RezerveApp — Berberinizin Online Randevu Sistemi</title>

    <meta name="description"
          content="Berber ve kuaför işletmeleri için online randevu yönetim sistemi. İşletmenizi oluşturun, çalışanlarınızı yönetin, müşterilerinizden online randevu alın.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
</head>

<body>

    <!-- ========== NAVIGATION ========== -->

    <nav class="nav" id="mainNav">

        <div class="nav__inner">

            <a asp-controller="Home"
               asp-action="Index"
               class="nav__logo" style="display: flex; align-items: center; gap: 8px; justify-content: center; text-decoration: none;">

                <img src="~/images/logo_dark.jpg" alt="RezerveApp Logo" style="height: 40px; object-fit: contain;" />
                <span style="font-size: 24px; font-weight: 700; color: #fff;">Rezerve<span style="color: var(--color-gold);">App</span></span>
            </a>

            <div class="nav__links">

                <a href="#features" class="nav__link">
                    Özellikler
                </a>

                <a href="#how-it-works" class="nav__link">
                    Nasıl Çalışır
                </a>

                <a href="#pricing" class="nav__link">
                    Paketler
                </a>

            </div>

            <div class="nav__actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn--ghost">
                    Giriş Yap
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn--primary btn--sm">
                    Ücretsiz Başla
                </a>

            </div>

            <!-- Mobile -->

            <div class="nav__hamburger" id="navHamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>

        <div class="nav__mobile-menu" id="navMobile">

            <a href="#features" class="nav__link">
                Özellikler
            </a>

            <a href="#how-it-works" class="nav__link">
                Nasıl Çalışır
            </a>

            <a href="#pricing" class="nav__link">
                Paketler
            </a>

            <div class="nav__actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn--outline btn--full">
                    Giriş Yap
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn--primary btn--full">
                    Ücretsiz Başla
                </a>

            </div>

        </div>

        <div class="nav__overlay" id="navOverlay"></div>

    </nav>


    <!-- ========== HERO ========== -->

    <section class="hero">

        <div class="hero__bg">

            <img src="~/images/hero-barber.jpg"
                 alt="Premium Berber Salonu"
                 loading="eager">

        </div>

        <div class="container">

            <div class="hero__content">

                <div class="hero__badge">

                    <span class="badge badge--gold">
                        ✦ Online Randevu Platformu
                    </span>

                </div>

                <h1 class="hero__title">

                    Berberinizin randevularını
                    <span class="highlight">tek yerden</span>
                    yönetin.

                </h1>

                <p class="hero__description">

                    İşletmenizi oluşturun, çalışanlarınızı ve hizmetlerinizi yönetin.
                    Müşterileriniz size özel randevu sayfanızdan kolayca randevu alsın.

                </p>

                <div class="hero__actions">

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn--primary btn--lg">
                        Ücretsiz Başla
                    </a>

                    <a href="#how-it-works"
                       class="btn btn--outline btn--lg">
                        Nasıl Çalışır?
                    </a>

                </div>

                <div class="hero__stats">

                    <div>
                        <div class="hero__stat-value">
                            500<span>+</span>
                        </div>

                        <div class="hero__stat-label">
                            Aktif İşletme
                        </div>
                    </div>

                    <div>
                        <div class="hero__stat-value">
                            15K<span>+</span>
                        </div>

                        <div class="hero__stat-label">
                            Randevu
                        </div>
                    </div>

                    <div>
                        <div class="hero__stat-value">
                            %98
                        </div>

                        <div class="hero__stat-label">
                            Memnuniyet
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== FEATURES ========== -->

    <section class="section section--dark" id="features">

        <div class="container">

            <div class="section-header text-center reveal">

                <span class="section-label">
                    Özellikler
                </span>

                <h2 class="section-title">
                    İşletmeniz için ihtiyacınız olan her şey
                </h2>

                <p class="section-subtitle">
                    Randevu yönetiminden müşteri takibine kadar tüm süreçlerinizi
                    tek bir platformdan yönetin.
                </p>

            </div>

            <div class="features__grid">

                <div class="feature-item reveal reveal-delay-1">

                    <div class="feature-item__icon">
                        <i data-lucide="calendar-check"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Online Randevu
                        </h4>

                        <p>
                            Müşterileriniz 7/24 online randevu alabilir.
                            Otomatik onay ve hatırlatma bildirimleri.
                        </p>

                    </div>

                </div>


                <div class="feature-item reveal reveal-delay-2">

                    <div class="feature-item__icon">
                        <i data-lucide="users"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Çalışan Yönetimi
                        </h4>

                        <p>
                            Çalışanlarınızı ekleyin, uzmanlık alanlarını
                            ve çalışma saatlerini belirleyin.
                        </p>

                    </div>

                </div>


                <div class="feature-item reveal reveal-delay-3">

                    <div class="feature-item__icon">
                        <i data-lucide="scissors"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Hizmet Yönetimi
                        </h4>

                        <p>
                            Sunduğunuz hizmetleri, fiyatları ve sürelerini
                            kolayca tanımlayın ve güncelleyin.
                        </p>

                    </div>

                </div>


                <div class="feature-item reveal reveal-delay-1">

                    <div class="feature-item__icon">
                        <i data-lucide="clock"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Çalışma Saatleri
                        </h4>

                        <p>
                            Esnek çalışma saatleri tanımlayın.
                            Tatil günleri ve özel saatler belirleyin.
                        </p>

                    </div>

                </div>


                <div class="feature-item reveal reveal-delay-2">

                    <div class="feature-item__icon">
                        <i data-lucide="contact"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Müşteri Yönetimi
                        </h4>

                        <p>
                            Müşteri bilgilerini ve randevu geçmişini takip edin.
                            Sadık müşterilerinizi tanıyın.
                        </p>

                    </div>

                </div>


                <div class="feature-item reveal reveal-delay-3">

                    <div class="feature-item__icon">
                        <i data-lucide="calendar-days"></i>
                    </div>

                    <div class="feature-item__content">

                        <h4>
                            Randevu Takvimi
                        </h4>

                        <p>
                            Tüm randevularınızı takvim görünümünde takip edin.
                            Günlük, haftalık ve aylık görünüm.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== HOW IT WORKS ========== -->

    <section class="section" id="how-it-works">

        <div class="container">

            <div class="section-header text-center reveal">

                <span class="section-label">
                    Nasıl Çalışır
                </span>

                <h2 class="section-title">
                    Üç adımda başlayın
                </h2>

                <p class="section-subtitle">
                    Dakikalar içinde işletmenizi dijitalleştirin
                    ve online randevu almaya başlayın.
                </p>

            </div>

            <div class="steps">

                <div class="step reveal reveal-delay-1">

                    <div class="step__number">
                        01
                    </div>

                    <h4 class="step__title">
                        Hesabınızı oluşturun
                    </h4>

                    <p class="step__desc">
                        Ücretsiz kayıt olun. E-posta ve temel bilgilerinizle
                        saniyeler içinde başlayın.
                    </p>

                </div>


                <div class="step reveal reveal-delay-2">

                    <div class="step__number">
                        02
                    </div>

                    <h4 class="step__title">
                        İşletmenizi kurun
                    </h4>

                    <p class="step__desc">
                        İşletme bilgilerini girin, çalışanlarınızı
                        ve hizmetlerinizi ekleyin.
                    </p>

                </div>


                <div class="step reveal reveal-delay-3">

                    <div class="step__number">
                        03
                    </div>

                    <h4 class="step__title">
                        Randevu almaya başlayın
                    </h4>

                    <p class="step__desc">
                        Size özel randevu sayfanızı paylaşın ve
                        müşterilerinizden online randevu alın.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== APPOINTMENT PREVIEW ========== -->

