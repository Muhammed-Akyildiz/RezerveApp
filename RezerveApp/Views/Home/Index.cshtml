                        </div>

                    </div>


                    <!-- Mockup Footer -->

                    <div class="mockup-footer">

                        <button class="btn btn--primary btn--full"
                                type="button">
                            Randevu Al
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== DASHBOARD PREVIEW ========== -->

    <section class="section" id="dashboard-preview">

        <div class="container">

            <div class="section-header text-center reveal">

