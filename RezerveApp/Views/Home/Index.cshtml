    <!-- ========== PRICING ========== -->

    <section class="section section--dark" id="pricing">

        <div class="container">

            <div class="section-header text-center reveal">

                <span class="section-label">
                    Paketler
                </span>

                <h2 class="section-title">
                    İşletmenize uygun planı seçin
                </h2>

                <p class="section-subtitle">
                    Her ölçekteki işletme için uygun fiyatlı planlar.
                    İstediğiniz zaman yükseltin.
                </p>

            </div>


            <div class="pricing__grid">

                <!-- Free -->

                <div class="pricing-card reveal reveal-delay-1">

                    <div class="pricing-card__badge">

                        <span class="badge badge--dark">
                            Ücretsiz
                        </span>

                    </div>

                    <h3 class="pricing-card__name">
                        Başlangıç
                    </h3>

                    <p class="pricing-card__desc">
                        Küçük işletmeler için temel özellikler.
                    </p>

                    <div class="price">

                        <span class="price__currency">
                            ₺
                        </span>

                        <span class="price__amount">
                            @(Model?.FirstOrDefault(p => p.Type == RezerveApp.Models.SubscriptionPlanType.Starter)?.MonthlyPrice.ToString("0") ?? "0")
