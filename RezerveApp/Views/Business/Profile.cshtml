@model RezerveApp.Models.Business

@{
    Layout = "_BusinessLayout";
    ViewBag.PageEyebrow = "İşletme Yönetimi";
    ViewBag.PageTitle = "Ayarlar";
    ViewBag.PageSubtitle = "İşletmenizin detaylarını, görünümünü ve hesap güvenliğini yönetin.";
    ViewBag.ActiveNav = "Profile";

    var currentLat = Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var currentLng = Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
}

@if (TempData["Error"] != null)
{
    <div class="profile-alert profile-alert-error">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="profile-alert profile-alert-success">@TempData["Success"]</div>
}

<style>
    /* Sekme Tasarımı */
    .settings-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border-soft);
        overflow-x: auto;
        padding-bottom: 0px;
    }

    .settings-tab {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 14.5px;
        font-weight: 600;
        padding: 12px 16px;
        cursor: pointer;
        position: relative;
        white-space: nowrap;
        transition: color 0.2s var(--ease);
        font-family: var(--font-body);
    }

    .settings-tab:hover {
        color: var(--text);
    }

    .settings-tab.active {
        color: var(--gold);
    }

    .settings-tab.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gold);
        border-radius: 3px 3px 0 0;
    }

    /* Animasyon */
    .settings-content {
        display: none;
        animation: fadeIn 0.3s ease;
    }

    .settings-content.active {
        display: block;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<!-- TABS (SEKMELER) -->
<div class="settings-tabs">
    <button type="button" class="settings-tab active" data-target="tab-general">Genel Bilgiler</button>
    <button type="button" class="settings-tab" data-target="tab-visuals">Görünüm ve Medya</button>
    <button type="button" class="settings-tab" data-target="tab-security">Güvenlik (Şifre)</button>
</div>

<!-- TEK BİR FORM KULLANIYORUZ, GÖNDERİLİNCE HEPSİ GİDER -->
<form asp-controller="Business"
      asp-action="SaveProfile"
      method="post"
      enctype="multipart/form-data"
      class="profile-form">

    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="latitude" id="latitude" value="@currentLat" />
    <input type="hidden" name="longitude" id="longitude" value="@currentLng" />

    <!-- TAB 1: GENEL BİLGİLER -->
    <div class="settings-content active" id="tab-general">
        <div class="profile-card">
            <div class="profile-card-head">
                <div>
                    <h2>Genel Bilgiler</h2>
                    <p>Müşterilerinizin göreceği temel işletme bilgileriniz.</p>
                </div>
            </div>

            <div class="profile-grid">
                <div class="profile-field">
                    <label>İşletme Adı</label>
                    <input class="profile-input" name="name" value="@Model.Name" required />
                </div>

                <div class="profile-field">
                    <label>Telefon</label>
                    <input class="profile-input" name="phone" value="@Model.Phone" maxlength="11" required />
                </div>

                <div class="profile-field">
                    <label>Instagram Kullanıcı Adı</label>
                    <input class="profile-input" type="text" name="instagram" value="@Model.Instagram" placeholder="Örn. @@rezerveappson" />
                </div>

                <div class="profile-field">
                    <label>Randevu Periyodu (Dakika)</label>
                    <select class="profile-input" name="slotInterval">
                        <option value="15" selected="@(Model.SlotInterval == 15 ? "selected" : null)">15 Dakikada Bir</option>
                        <option value="20" selected="@(Model.SlotInterval == 20 ? "selected" : null)">20 Dakikada Bir</option>
                        <option value="30" selected="@(Model.SlotInterval == 30 ? "selected" : null)">30 Dakikada Bir</option>
                        <option value="45" selected="@(Model.SlotInterval == 45 ? "selected" : null)">45 Dakikada Bir</option>
                        <option value="60" selected="@(Model.SlotInterval == 60 ? "selected" : null)">60 Dakikada Bir</option>
                    </select>
                </div>

                <div class="profile-field">
                    <label>Şehir</label>
                    <input class="profile-input" name="city" value="@Model.City" />
                </div>

                <div class="profile-field">
                    <label>İlçe</label>
                    <input class="profile-input" name="district" value="@Model.District" />
                </div>

                <div class="profile-field profile-field-wide">
                    <label>Açık Adres</label>
                    <textarea class="profile-input" name="address" rows="3">@Model.Address</textarea>
                </div>
            </div>

            <div class="map-picker-section" style="margin-top: 32px;">
                <div class="map-picker-head">
                    <div>
                        <h3>İşletme Konumu</h3>
                        <p>Haritada işletmenizin bulunduğu noktaya tıklayın. Seçilen konum müşterilerin randevu sayfasında gösterilir.</p>
                    </div>

                    <button type="button" id="useMyLocation" class="map-location-btn">
                        Konumumu Kullan
                    </button>
                </div>

                <div id="businessPickerMap" class="business-picker-map"></div>

                <div class="coordinates">
                    <span>Enlem: <strong id="latText">@(currentLat == "" ? "Seçilmedi" : currentLat)</strong></span>
                    <span>Boylam: <strong id="lngText">@(currentLng == "" ? "Seçilmedi" : currentLng)</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: GÖRÜNÜM VE MEDYA -->
    <div class="settings-content" id="tab-visuals">
        <div class="profile-card">
            <div class="profile-card-head">
                <div>
                    <h2>Logo ve Görünüm</h2>
                    <p>İşletmenizin marka kimliği ve vitrin fotoğrafları.</p>
                </div>
            </div>

            <div class="profile-field profile-field-wide" style="margin-bottom: 30px;">
                <label>İşletme Logosu</label>
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <div style="margin-bottom: var(--space-md);">
                        <img src="@Model.LogoUrl" alt="Mevcut Logo" style="width: 80px; height: 80px; border-radius: var(--radius-md); object-fit: cover; border: 1px solid var(--border);" />
                    </div>
                }
                <input class="profile-input" type="file" name="logo" accept=".jpg,.jpeg,.png,.webp" />
                <small>JPG, PNG veya WEBP — maksimum 5 MB.</small>
            </div>

            <h3 class="profile-section-title" style="margin-top: 30px; border-bottom: 1px solid var(--border-soft); padding-bottom: 10px;">Müşteri Sayfası Galerisi</h3>
            <p style="margin-bottom: 20px; font-size: 14px; color: var(--text-faint);">Müşterilerinize işletmenizin fotoğraflarını gösterin. Eğer fotoğraf eklemezseniz sistemin varsayılan stok görselleri kullanılacaktır.</p>

            <div class="profile-grid">
                <div class="profile-field">
                    <label>Galeri Fotoğrafı 1 (Ana Görsel)</label>
                    @if (!string.IsNullOrEmpty(Model.GalleryImage1))
                    {
                        <div style="margin-bottom: 10px;">
                            <img src="@Model.GalleryImage1" alt="Galeri 1" style="width: 100%; height: 120px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border-soft);" />
                        </div>
                    }
                    <input class="profile-input" type="file" name="gallery1" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="profile-field">
                    <label>Galeri Fotoğrafı 2 (Yan Görsel)</label>
                    @if (!string.IsNullOrEmpty(Model.GalleryImage2))
                    {
                        <div style="margin-bottom: 10px;">
                            <img src="@Model.GalleryImage2" alt="Galeri 2" style="width: 100%; height: 120px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border-soft);" />
                        </div>
                    }
                    <input class="profile-input" type="file" name="gallery2" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="profile-field">
                    <label>Galeri Fotoğrafı 3 (Yan Görsel)</label>
                    @if (!string.IsNullOrEmpty(Model.GalleryImage3))
                    {
                        <div style="margin-bottom: 10px;">
                            <img src="@Model.GalleryImage3" alt="Galeri 3" style="width: 100%; height: 120px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border-soft);" />
                        </div>
                    }
                    <input class="profile-input" type="file" name="gallery3" accept=".jpg,.jpeg,.png,.webp" />
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: GÜVENLİK (ŞİFRE) -->
    <div class="settings-content" id="tab-security">
        <div class="profile-card">
            <div class="profile-card-head">
                <div>
                    <h2>Şifre ve Güvenlik</h2>
                    <p>Hesap güvenliğinizi sağlamak için parolanızı değiştirin.</p>
                </div>
            </div>

            <p style="color: var(--text-faint); margin-bottom: 20px; font-size: 13px;">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakın.</p>

            <div class="profile-grid">
                <div class="profile-field">
                    <label>Mevcut Şifre</label>
                    <input type="password" name="currentPassword" placeholder="Mevcut şifreniz" class="profile-input" />
                </div>
                <div class="profile-field">
                    <label>Yeni Şifre</label>
                    <input type="password" name="newPassword" placeholder="Yeni şifre" class="profile-input" />
                </div>
                <div class="profile-field">
                    <label>Yeni Şifre (Tekrar)</label>
                    <input type="password" name="confirmNewPassword" placeholder="Yeni şifreyi doğrulayın" class="profile-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="profile-actions" style="margin-top: 30px; display:flex; justify-content:flex-end;">
        <button type="submit" class="save-profile-btn btn-gold" style="padding: 12px 32px; font-size:15px; border-radius:12px;">Değişiklikleri Kaydet</button>
    </div>

</form>

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin="" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            crossorigin=""></script>

    <script>
        // --- SEKME (TAB) MANTIĞI ---
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll('.settings-tab');
            const contents = document.querySelectorAll('.settings-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    // Tüm aktif durumları temizle
                    tabs.forEach(t => t.classList.remove('active'));
                    contents.forEach(c => c.classList.remove('active'));

                    // Tıklanan sekmeyi aktif yap
                    tab.classList.add('active');
                    const targetId = tab.getAttribute('data-target');
                    document.getElementById(targetId).classList.add('active');

                    // Harita sekmesi açıldığında Leaflet'in haritayı yeniden boyutlandırmasını sağla
                    if (targetId === 'tab-general') {
                        setTimeout(() => {
                            if(window.businessMap) {
                                window.businessMap.invalidateSize();
                            }
                        }, 100);
                    }
                });
            });
        });

        // --- HARİTA MANTIĞI ---
        const defaultIcon = L.icon({
            iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
            iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        });

        document.addEventListener("DOMContentLoaded", function () {
            const latInput = document.getElementById("latitude");
            const lngInput = document.getElementById("longitude");
            const latText = document.getElementById("latText");
            const lngText = document.getElementById("lngText");
            const mapElement = document.getElementById("businessPickerMap");

            let existingLat = parseFloat(latInput.value);
            let existingLng = parseFloat(lngInput.value);

            if (Number.isFinite(existingLat) && (existingLat < -90 || existingLat > 90)) {
                existingLat = NaN;
            }
            if (Number.isFinite(existingLng) && (existingLng < -180 || existingLng > 180)) {
                existingLng = NaN;
            }

            const initialLat = Number.isFinite(existingLat) ? existingLat : 38.9637;
            const initialLng = Number.isFinite(existingLng) ? existingLng : 35.2433;
            const initialZoom = Number.isFinite(existingLat) && Number.isFinite(existingLng) ? 16 : 6;

            const map = L.map(mapElement).setView([initialLat, initialLng], initialZoom);
            window.businessMap = map; // Global olarak kaydet

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);

            let marker = null;

            function setLocation(lat, lng) {
                latInput.value = lat.toFixed(7);
                lngInput.value = lng.toFixed(7);
                latText.textContent = lat.toFixed(7);
                lngText.textContent = lng.toFixed(7);

                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng], {icon: defaultIcon}).addTo(map);
                }
                marker.bindPopup("İşletme konumu").openPopup();
            }

            if (Number.isFinite(existingLat) && Number.isFinite(existingLng)) {
                setLocation(existingLat, existingLng);
            }

            map.on("click", function (event) {
                setLocation(event.latlng.lat, event.latlng.lng);
            });

            document.getElementById("useMyLocation").addEventListener("click", function () {
                if (!navigator.geolocation) {
                    alert("Tarayıcınız konum özelliğini desteklemiyor.");
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        map.setView([lat, lng], 17);
                        setLocation(lat, lng);
                    },
                    function () {
                        alert("Konum alınamadı. Harita üzerinde işletmenizin bulunduğu noktaya tıklayabilirsiniz.");
                    }
                );
            });

            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
}
