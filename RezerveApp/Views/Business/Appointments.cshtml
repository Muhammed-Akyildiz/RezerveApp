@model List<RezerveApp.Models.Appointment>

@{
    Layout = "_BusinessLayout";
    ViewBag.PageEyebrow = "Yönetim";
    ViewBag.PageTitle = "Randevular";
    ViewBag.PageSubtitle = "Tüm randevularınızı görüntüleyin ve yönetin";
    ViewBag.ActiveNav = "Appointments";
}

@section TopbarActions {
    <a asp-controller="Business" asp-action="CreateAppointment" class="btn btn-gold">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Yeni Randevu
    </a>
}

@if (TempData["Error"] != null)
{
    <div class="hint" style="color:var(--danger); margin-bottom:16px;">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="hint" style="color:var(--success); margin-bottom:16px;">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-pad" style="padding-bottom:0;">
        <form method="get" asp-controller="Business" asp-action="Appointments" class="toolbar">
            <div class="input-with-icon">
                <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" class="input" name="q" value="@ViewBag.SearchQuery" placeholder="Müşteri adı veya telefon ara..." />
            </div>
            <select class="select filter-select" name="status" onchange="this.form.submit()">
                <option value="">Tüm durumlar</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Bekliyor</option>
                <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved")">Onaylandı</option>
                <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Tamamlandı</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">İptal</option>
                <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected")">Reddedildi</option>
                <option value="NoShow" selected="@(ViewBag.StatusFilter == "NoShow")">Gelmedi</option>
            </select>
            <input type="date" class="input" style="width:auto;" name="date" value="@(ViewBag.DateFilter != null ? ((DateTime)ViewBag.DateFilter).ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
            <button type="submit" class="btn btn-outline btn-sm">Filtrele</button>
            <a asp-controller="Business" asp-action="Appointments" class="btn btn-ghost btn-sm">Temizle</a>
            <div class="toolbar-spacer"></div>
        </form>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tarih / Saat</th>
                    <th>Müşteri</th>
                    <th>Hizmet</th>
                    <th>Berber</th>
                    <th>Durum</th>
                    <th style="text-align:right;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="cell-muted">Kriterlere uyan randevu bulunamadı.</td></tr>
                }
                
                @{
                    // Geriye dönük uyumluluk için, GroupId'si olmayanları kendi Id'si ile grupluyoruz
                    var groupedAppointments = Model.GroupBy(a => string.IsNullOrEmpty(a.GroupId) ? a.Id.ToString() : a.GroupId);
                }

                @foreach (var group in groupedAppointments)
                {
                    var a = group.OrderBy(x => x.StartTime).First();
                    var allServices = string.Join(" + ", group.OrderBy(x => x.StartTime).Select(x => x.Service?.Name));
                    var totalDuration = group.Sum(x => x.Service?.DurationMinutes ?? 0);
                    
                    <tr>
                        <td class="cell-primary" data-label="Tarih / Saat">
                            @a.AppointmentDate.ToString("dd.MM.yyyy") <span class="cell-muted" style="font-size:12px; margin-left:4px;">@a.StartTime.ToString("hh\\:mm")</span>
                        </td>
                        <td data-label="Müşteri">
                            <span class="cell-primary" style="display:block; font-weight:600;">@a.CustomerName</span>
                            <span class="cell-muted" style="font-size:13px;">@a.CustomerPhone</span>
                        </td>
                        <td class="cell-muted" data-label="Hizmet">@allServices</td>
                        <td class="cell-muted" data-label="Berber">@a.Employee?.Name</td>
                        <td data-label="Durum">
                            @switch (a.Status)
                            {
                                case "Approved":
                                    <span class="badge badge-success">Onaylandı</span>
                                    break;
                                case "Pending":
                                    <span class="badge badge-gold">Bekliyor</span>
                                    break;
                                case "Completed":
                                    <span class="badge badge-success">Tamamlandı</span>
                                    break;
                                case "NoShow":
                                    <span class="badge badge-neutral">Gelmedi</span>
                                    break;
                                default:
                                    <span class="badge badge-danger">@(a.Status == "Rejected" ? "Reddedildi" : "İptal")</span>
                                    break;
                            }
                        </td>
                        <td style="text-align:right;" data-label="İşlem">
                            @{
                                var digits = new string((a.CustomerPhone ?? "").Where(char.IsDigit).ToArray());
                                var waPhone = digits.Length == 11 && digits.StartsWith("0") ? "90" + digits.Substring(1) : (digits.StartsWith("90") ? digits : "90" + digits);
                                var waText = System.Net.WebUtility.UrlEncode($"Merhaba {a.CustomerName}, bugün saat {a.StartTime:hh\\:mm}'de randevunuz bulunmaktadır. Lütfen gecikmeyiniz.");
                                var waLink = $"https://wa.me/{waPhone}?text={waText}";
                            }

                            @if (a.Status == "Approved" || a.Status == "Pending")
                            {
                                <a href="@waLink" target="_blank" class="btn btn-ghost btn-sm" style="color:#25D366; border-color:transparent;" title="WhatsApp'tan Hatırlat">
                                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                    WhatsApp
                                </a>
                            }
                            else if (a.Status == "Completed")
                            {
                                var reviewUrl = Url.Action("Leave", "Review", new { appointmentId = a.Id }, Context.Request.Scheme);
                                var reviewWaText = System.Net.WebUtility.UrlEncode($"RezerveApp üzerinden aldığınız hizmet tamamlandı. Bizi değerlendirmek ister misiniz? Link: {reviewUrl}");
                                var reviewWaLink = $"https://wa.me/{waPhone}?text={reviewWaText}";

                                <a href="@reviewWaLink" target="_blank" class="btn btn-ghost btn-sm" style="color:#d4af37; border-color:transparent;" title="Değerlendirme İste">
                                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                    Değerlendirme İste
                                </a>
                            }

                            @if (a.Status == "Pending")
                            {
                                <form asp-controller="Business" asp-action="ConfirmAppointment" asp-route-id="@a.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm" style="background-color: var(--success); color: white; border: none; font-weight: bold;">
                                        <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12" /></svg>
                                        Onayla
                                    </button>
                                </form>
                            }
                            @if (a.Status == "Approved" && a.AppointmentDate.Date <= DateTime.Today)
                            {
                                <form asp-controller="Business" asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <button type="submit" class="btn btn-ghost btn-sm">Tamamlandı</button>
                                </form>
                                <form asp-controller="Business" asp-action="UpdateAppointmentStatus" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="status" value="NoShow" />
                                    <button type="submit" class="btn btn-ghost btn-sm">Gelmedi</button>
                                </form>
                            }
                            @if (a.Status != "Cancelled" && a.Status != "Rejected" && a.Status != "Completed")
                            {
                                <form asp-controller="Business" asp-action="CancelAppointment" asp-route-id="@a.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">
                                        İptal
                                    </button>
                                </form>
                            }
                            <form asp-controller="Business" asp-action="DeleteAppointment" asp-route-id="@a.Id" method="post" style="display:inline;" data-confirm="Bu kaydı <b>kalıcı olarak</b> silmek istediğinize emin misiniz?<br><br><span style='font-size:12px; color:#888;'>Bu işlem geri alınamaz ve ilişkili diğer veriler etkilenebilir.</span>" data-confirm-title="Randevuyu Sil">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--text-faint);" title="Kalıcı Olarak Sil">
                                    <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <div class="pagination-info">@Model.Count randevu gösteriliyor</div>
    </div>
</div>

